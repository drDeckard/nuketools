set cut_paste_input [stack 0]
version 14.0 v5
push $cut_paste_input
Group {
 name STMap_Overscan
 selected true
 xpos 169
 ypos -9
 addUserKnob {20 User}
 addUserKnob {6 repeat l "Remove Repeated Values" t "Finding and removing stretched pixels with same value, giving the extension wrong result if included." +STARTLINE}
 repeat true
 addUserKnob {6 crop l "Show Overscan" +STARTLINE}
 addUserKnob {7 overscan l Overscan t "Format * Overscan = New Format" R 1 2}
 overscan 1.2
 addUserKnob {7 erode l Erode t "If STMap has \"crap\" values in the edges. Erode to avoid including this in extend." R 0 200}
 erode 1
 addUserKnob {41 size l Blur t "To reduce artifacts, higher values needed when pushing very distorted maps into very big overscans." T Blur5.size}
 addUserKnob {41 size_1 l "Distance Blur" T Blur1Dist.size}
 addUserKnob {7 blend l "Edge Blend" t "Softness pixels in edge between original STMap and extension." R 0 50}
 blend 1
 addUserKnob {26 ""}
 addUserKnob {4 lenscenter l "Lens Center" M {"Format center" "Sampled center" ""}}
 addUserKnob {12 centerpos l "" -STARTLINE}
 centerpos {{"lenscenter == 0 ? width/2 : this.CurveTool1.minlumapixdata.x"} {"lenscenter == 0 ? height/2 : this.CurveTool1.minlumapixdata.y"}}
 addUserKnob {41 go l "Sample Center" -STARTLINE T CurveTool1.go}
 addUserKnob {26 ""}
 addUserKnob {4 method l Method t "Linear can work good for really small extends but most often Least Squares Regression is the best." M {Linear Quadratic "Least Squares Regression" "" ""}}
 method "Least Squares Regression"
 addUserKnob {41 STMapOverscan_edgeDistance l edgeDistance t "How far in from edge (in px) to shoot ray. Needs to be pretty low if using linear. For maximum quality aim for width/2 using Least Squares." T stmap_kernel.STMapOverscan_edgeDistance}
 addUserKnob {41 STMapOverscan_rayCount l rayCount t "How many rays per pixel, higher values can be good for reducing artifacts in wide heavy distorted maps." T stmap_kernel.STMapOverscan_rayCount}
 addUserKnob {41 STMapOverscan_raySpread l raySpread t "How much should the rays spread per pixel in degrees. Seems best under 1 as higher values can add noise instead of opposite." T stmap_kernel.STMapOverscan_raySpread}
 addUserKnob {41 STMapOverscan_raySamples l raySamples t "How many samples along ray." T stmap_kernel.STMapOverscan_raySamples}
 addUserKnob {41 STMapOverscan_fanBlendDistance l fanBlendDistance t "How far away from edge we get maximum fanSpread" T stmap_kernel.STMapOverscan_fanBlendDistance}
 addUserKnob {6 preview l Preview +STARTLINE}
 addUserKnob {26 ""}
 addUserKnob {26 credits l "" +STARTLINE T "Based on Marty Blumens STMapExtension 2.0\n\nSTMap_Overscan 1.3 Calle Granström"}
}
