  which {{"\[exists parent.input0]" x1 0}}
  name Switch2
  xpos 509
  ypos -503
 }
 Dot {
  name Dot1
  xpos 543
  ypos -441
 }
set Ndfede400 [stack 0]
 BlinkScript {
  recompileCount 1
  ProgramGroup 1
  KernelDescription "2 \"STMapUniqueAlpha\" iterate pixelWise aab2a4f5099271b3e6ba1559a87d08687eb1f04d026f518d0f23f4ede4bea43a 2 \"src\" Read Random \"dst\" Write Point 1 \"tolerance\" Float 1 rMUnNw== 1 \"tolerance\" 1 1 0"
  kernelSource "kernel STMapUniqueAlpha : ImageComputationKernel<ePixelWise>\n\{\n  Image<eRead, eAccessRandom, eEdgeClamped> src;\n  Image<eWrite> dst;\n\n  param:\n    float tolerance; // Threshold for matching pixels. Keep it tiny!\n\n  void define() \{\n    // 0.00001 is small enough to catch clamps, but small enough \n    // not to accidentally delete valid high-res STMap gradients.\n    defineParam(tolerance, \"tolerance\", 0.00001f);\n  \}\n\n  void init() \{\}\n\n  void process(int2 pos) \{\n    float4 out = src(pos.x, pos.y);\n    float2 c = float2(out.x, out.y);\n    \n    float newAlpha = 0.0f;\n\n    // Condition 1: Must be greater than 0\n    if (c.x > 0.0f || c.y > 0.0f) \{\n        \n        // Sample the 4 immediate neighbors\n        float2 l = float2(src(pos.x - 1, pos.y).x, src(pos.x - 1, pos.y).y);\n        float2 r = float2(src(pos.x + 1, pos.y).x, src(pos.x + 1, pos.y).y);\n        float2 u = float2(src(pos.x, pos.y + 1).x, src(pos.x, pos.y + 1).y);\n        float2 d = float2(src(pos.x, pos.y - 1).x, src(pos.x, pos.y - 1).y);\n\n        bool isUnique = true;\n        \n        // Condition 2: If the difference between this pixel and ANY neighbor \n        // is smaller than the tolerance, it is a repeating/clamped edge.\n        if (fabs(c.x - l.x) <= tolerance && fabs(c.y - l.y) <= tolerance) isUnique = false;\n        if (fabs(c.x - r.x) <= tolerance && fabs(c.y - r.y) <= tolerance) isUnique = false;\n        if (fabs(c.x - u.x) <= tolerance && fabs(c.y - u.y) <= tolerance) isUnique = false;\n        if (fabs(c.x - d.x) <= tolerance && fabs(c.y - d.y) <= tolerance) isUnique = false;\n\n        if (isUnique) \{\n            newAlpha = 1.0f;\n        \}\n    \}\n\n    // Output original RGB, but inject our new calculated alpha\n    out.w = newAlpha;\n    dst() = out;\n  \}\n\};"
  rebuild ""
  STMapUniqueAlpha_tolerance 5e-05
  rebuild_finalise ""
  name BlinkScript1
  xpos 606
  ypos -384
 }
push $Ndfede400
